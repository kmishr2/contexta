# Local development only; do not use this credential for a real deployment.
POSTGRES_DB=contexta
POSTGRES_USER=contexta
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Phase 2 is disabled until explicitly configured. These are local-only examples.
# Export these in the API shell; Compose's .env is not automatically loaded by the API.
# CONTEXA_DEVELOPMENT_OWNER=true
# CONTEXA_METADATA_URL=postgresql+psycopg://contexta:local-development-only@127.0.0.1:5432/contexta
# CONTEXA_ALLOWED_DESTINATIONS=["127.0.0.1:5432"]
# CONTEXA_ALLOW_INSECURE_LOCAL_SOURCES=true
# CONTEXA_SOURCE_COMMERCE=local-reader-only

# Reporting calendar time zone for relative periods (defaults to UTC):
# CONTEXA_REPORTING_TIMEZONE=Asia/Kolkata

# Opt in to onboarding suggestions from Ollama on 127.0.0.1:11434.
# CONTEXA_LOCAL_AI_ONBOARDING=true
# Opt in to local AI interpretation of analyst questions.
# CONTEXA_LOCAL_AI_CHAT=true

# Optional disposable subscriptions fixture reader:
# CONTEXA_SOURCE_SUB_FIXTURE=local-sub-reader-only

# Optional local identity configuration. Do not enable CONTEXA_DEVELOPMENT_OWNER
# at the same time. Generate strong tokens with scripts/generate_local_token.py.
# CONTEXA_IDENTITIES='[{"id":"owner","role":"owner","token_sha256":"REPLACE_WITH_SHA256_HEX"},{"id":"analyst","role":"analyst","token_sha256":"REPLACE_WITH_SHA256_HEX","connections":["REPLACE_WITH_CONNECTION_UUID"]}]'
